# ============================================================
# SupportBot BSRP — Environment Config
# Kopiraj u .env i popuni stvarne vrednosti. NIKADA ne commit-uj .env
# ============================================================

# Discord bot token (Discord Developer Portal)
DISCORD_TOKEN=

# Addons system secret key — random 32+ karaktera (generiši: openssl rand -hex 32)
ADDONS_SECRET_KEY=

# Updater secret — isti nivo zaštite, može biti isti kao ADDONS_SECRET_KEY
UPDATER_SECRET_KEY=

# AI model API key (OpenAI/Groq/Claude)
MODEL_API_KEY=

# Pastebin API key (za duge AI odgovore)
PASTEBIN_API_KEY=

# API port — NEMOJ 3000 (konflikt sa Dokploy). Default 8099
API_PORT=8099

# Admin panel origin za CORS (npr. https://admin.tvoj-domen.rs) — prazno = bez CORS (same-origin)
ADMIN_PANEL_ORIGIN=

# Guild lockdown — bot radi SAMO na ovom serveru (Balkan Syndicate RP)
ALLOWED_GUILD_ID=

# API bind adresa — 127.0.0.1 (default, sigurno) ili 0.0.0.0 (samo ako bas moras)
API_BIND=127.0.0.1

# Update izvor — hardkodovan URL tvog release zipa. NIKADA se ne prima od korisnika.
UPDATE_URL=
